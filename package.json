{
  "name": "actualengineer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "start": "node scripts/run-next.mjs start",
    "prebuild": "node scripts/check-content.mjs && node scripts/punchlist.mjs --ci",
    "build": "next build",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write --ignore-unknown",
    "format:check": "prettier --check .",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "check:content": "node scripts/check-content.mjs",
    "punchlist": "node scripts/punchlist.mjs",
    "check:static": "node scripts/checks/static-routes.mjs",
    "test:unit": "playwright test --project=unit",
    "verify:quick": "npm run lint && npm run typecheck && npm run check:content && npm run test:unit",
    "verify": "node scripts/verify.mjs",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:smoke": "playwright test e2e/smoke.spec.ts --project=desktop --project=mobile",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=a11y",
    "test:keyboard": "playwright test e2e/keyboard.spec.ts --project=desktop",
    "test:figures": "playwright test e2e/figures --project=desktop --project=mobile",
    "test:stage": "playwright test e2e/stage.spec.ts --project=gpu",
    "test:prod": "playwright test e2e/prod.spec.ts --project=desktop",
    "seam": "playwright test e2e/seam.spec.ts --project=gpu",
    "shots": "playwright test e2e/shots.spec.ts --project=shots",
    "shots:frames": "playwright test e2e/frames.spec.ts --project=shots",
    "dump:text": "playwright test e2e/dump-text.spec.ts --project=desktop",
    "perf:budgets": "playwright test e2e/budgets.spec.ts --project=mobile && node scripts/budgets/html-size.mjs",
    "perf:lh": "node scripts/perf/lighthouse.mjs",
    "perf:analyze": "next experimental-analyze --output",
    "perf:3d": "node scripts/check-3d-bundle.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "@marsidev/react-turnstile": "1.6.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "roughjs": "4.6.6",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "schema-dts": "2.1.0",
    "typescript": "~5.9.3"
  }
}
