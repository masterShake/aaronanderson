{
  "name": "actualengineer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3120",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "shots": "node scripts/shots.mts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.187.0",
    "troika-three-text": "0.52.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.64.1",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
