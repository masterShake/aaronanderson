# Environment variables for actualengineer.com.
# `npm run punchlist -- --write` turns this file into the "Deployment settings" section of
# PLACEHOLDERS.md: "## Title" lines start a group, KEY= lines become rows (a leading # means
# optional), and "NOTE:" lines become checklist items. Never put real values in this file.

# ## Deployment
# NOTE: Vercel sets VERCEL_ENV itself. Set it locally only to test the production look.
# NOTE: Turn on Skew Protection in the Vercel project (Settings, Advanced) so old tabs keep working after a deploy.
# NOTE: Never Instant-Rollback to a build made before the HOLDs were filled; promote a fresh build instead.
# VERCEL_ENV=production          # production | preview | development
# SHOW_HOLDS=0                   # 1 = HOLD clouds visible; 0 = production fallbacks. Default: 0 only when VERCEL_ENV=production
# STRICT_HOLDS=1                 # set in Vercel's Production env at launch: the build fails while essential HOLDs or pending CONFIRMs remain
# CSP_MODE=report                # report = Content-Security-Policy-Report-Only; default enforce

# ## Contact form (server only)
# NOTE: Verify the sending domain in Resend and add its DNS records (SPF, DKIM, return path) at the domain host.
RESEND_API_KEY=                  # "Sending access" key restricted to the verified domain. Unset in dev: email is logged, not sent
CONTACT_TO_EMAIL=                # comma-separated inbox(es) that receive enquiries
CONTACT_FROM_EMAIL=              # e.g. Actual Engineer <contact@mail.actualengineer.com> (verified Resend domain)
FORM_TOKEN_SECRET=               # required in production; openssl rand -base64 32. Without it every form token counts as missing

# ## Booking
# NOTE: Create the Cal.com event and paste its link into src/content/site.ts (site.scheduler.url). There is no scheduler env var.

# ## Cloudflare Turnstile (optional; set both or neither)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY= # tests use 1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=          # tests use 1x0000000000000000000000000000000AA

# ## Rate limiting (optional; falls back to an in-memory limit per instance)
# UPSTASH_REDIS_REST_URL=        # KV_REST_API_URL is accepted as a fallback
# UPSTASH_REDIS_REST_TOKEN=      # KV_REST_API_TOKEN is accepted as a fallback

# ## Local tooling (never set on Vercel)
# PORT=3100                      # next start and Playwright; each worktree reads its own from .lane.env
# DEV_PORT=3120                  # next dev; read from .lane.env
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# LH_RUNS=5                      # Lighthouse runs per route
